{
  "expo": {
    "name": "MuseumAR",
    "slug": "MuseumAR-Frontend-Mobile",
    "version": "1.0.0",
    "scheme": "museumar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@azesmway/react-native-unity",
      [
        "expo-camera",
        {
          "cameraPermission": "MuseumAR cần camera để quét mã QR và hiển thị AR.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      "./plugins/withUnityGradleProperties.js",
      "./plugins/withUnityManifestMergerFixes.js",
      "./plugins/withCmakeLongPaths.js",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.museumar.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "MuseumAR cần camera để quét mã QR và hiển thị AR overlay."
      }
    },
    "android": {
      "package": "com.museumar.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiHost": "",
      "apiPort": "443",
      "apiBaseUrl": "https://museumar-geb6b8ajf7fuh4ba.japaneast-01.azurewebsites.net/api",
      "googleClientIds": {
        "web": "",
        "ios": "",
        "android": "",
        "expo": ""
      }
    }
  }
}
